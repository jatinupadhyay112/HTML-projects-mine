import { useState } from "react";

const PRODUCTS = [
  { id: 1, name: "Wireless Headphones", price: 1299 },
  { id: 2, name: "Mechanical Keyboard", price: 2499 },
  { id: 3, name: "USB-C Hub", price: 899 },
  { id: 4, name: "Webcam 1080p", price: 1799 },
];

export default function App() {
  const [cart, setCart] = useState({});

  const addItem = (id) =>
    setCart((c) => ({ ...c, [id]: (c[id] || 0) + 1 }));

  const removeItem = (id) =>
    setCart((c) => {
      const next = { ...c };
      delete next[id];
      return next;
    });

  const updateQty = (id, qty) => {
    if (qty < 1) return removeItem(id);
    setCart((c) => ({ ...c, [id]: qty }));
  };

  const totalItems = Object.values(cart).reduce((a, b) => a + b, 0);
  const totalPrice = Object.entries(cart).reduce(
    (sum, [id, qty]) =>
      sum + (PRODUCTS.find((p) => p.id === +id)?.price || 0) * qty,
    0
  );

  const cartItems = Object.entries(cart).map(([id, qty]) => ({
    ...PRODUCTS.find((p) => p.id === +id),
    qty,
  }));

  return (
    <div style={{ fontFamily: "Segoe UI, sans-serif", maxWidth: 700, margin: "30px auto", padding: "0 16px" }}>

      {/* Header */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 24 }}>
        <h4 style={{ margin: 0 }}>🛒 Shop</h4>
        <span style={{
          background: "#0d6efd", color: "#fff", borderRadius: 20,
          padding: "4px 14px", fontSize: 14, fontWeight: 600
        }}>
          {totalItems} item{totalItems !== 1 ? "s" : ""}
        </span>
      </div>

      <div style={{ display: "flex", gap: 20, flexWrap: "wrap" }}>

        {/* Products */}
        <div style={{ flex: 1, minWidth: 260 }}>
          <h6 style={{ borderBottom: "1px solid #dee2e6", paddingBottom: 6, marginBottom: 12 }}>Products</h6>
          {PRODUCTS.map((p) => (
            <div key={p.id} style={{
              display: "flex", justifyContent: "space-between", alignItems: "center",
              padding: "10px 12px", marginBottom: 8, borderRadius: 8,
              border: "1px solid #dee2e6", background: "#f8f9fa"
            }}>
              <div>
                <div style={{ fontWeight: 500, fontSize: 14 }}>{p.name}</div>
                <div style={{ color: "#0d6efd", fontSize: 13 }}>₹{p.price}</div>
              </div>
              <button
                onClick={() => addItem(p.id)}
                style={{
                  background: "#0d6efd", color: "#fff", border: "none",
                  borderRadius: 6, padding: "5px 12px", cursor: "pointer", fontSize: 13
                }}
              >
                + Add
              </button>
            </div>
          ))}
        </div>

        {/* Cart */}
        <div style={{ flex: 1, minWidth: 240 }}>
          <h6 style={{ borderBottom: "1px solid #dee2e6", paddingBottom: 6, marginBottom: 12 }}>Cart</h6>

          {cartItems.length === 0 ? (
            <p style={{ color: "#adb5bd", fontSize: 14, textAlign: "center", marginTop: 30 }}>
              Cart is empty
            </p>
          ) : (
            <>
              {cartItems.map((item) => (
                <div key={item.id} style={{
                  padding: "10px 12px", marginBottom: 8, borderRadius: 8,
                  border: "1px solid #dee2e6", background: "#fff"
                }}>
                  <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 6 }}>
                    <span style={{ fontSize: 13, fontWeight: 500 }}>{item.name}</span>
                    <button
                      onClick={() => removeItem(item.id)}
                      style={{
                        background: "none", border: "none", color: "#dc3545",
                        cursor: "pointer", fontSize: 16, lineHeight: 1
                      }}
                    >✕</button>
                  </div>
                  <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                    <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                      <button onClick={() => updateQty(item.id, item.qty - 1)}
                        style={qBtn}>−</button>
                      <span style={{ fontSize: 14, minWidth: 20, textAlign: "center" }}>{item.qty}</span>
                      <button onClick={() => updateQty(item.id, item.qty + 1)}
                        style={qBtn}>+</button>
                    </div>
                    <span style={{ fontSize: 13, color: "#0d6efd", fontWeight: 600 }}>
                      ₹{item.price * item.qty}
                    </span>
                  </div>
                </div>
              ))}

              {/* Total */}
              <div style={{
                display: "flex", justifyContent: "space-between", padding: "10px 12px",
                background: "#0d6efd", color: "#fff", borderRadius: 8, fontWeight: 700
              }}>
                <span>Total</span>
                <span>₹{totalPrice}</span>
              </div>
            </>
          )}
        </div>

      </div>
    </div>
  );
}

const qBtn = {
  width: 26, height: 26, border: "1px solid #dee2e6", background: "#f8f9fa",
  borderRadius: 5, cursor: "pointer", fontSize: 15, fontWeight: 700,
  display: "flex", alignItems: "center", justifyContent: "center"
};